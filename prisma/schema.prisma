// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum SubscriptionTier {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  username          String           @unique
  password          String
  role              UserRole         @default(BUYER)
  subscriptionTier  SubscriptionTier @default(FREE)
  subscriptionExpiry DateTime?
  emailVerified     Boolean          @default(false)
  emailVerificationToken String?
  emailVerificationExpiry DateTime?
  isVerifiedSeller  Boolean          @default(false)

  // 2FA
  twoFactorEnabled  Boolean          @default(false)
  twoFactorSecret   String?

  // Ban/Suspension
  isBanned          Boolean          @default(false)
  bannedAt          DateTime?
  bannedUntil       DateTime?        // null = permanent ban
  banReason         String?
  bannedBy          String?          // Admin user ID who banned

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  productsAsSellerV2  Product[]      @relation("SellerProducts")
  ordersAsBuyer      Order[]         @relation("BuyerOrders")
  ordersAsSeller     Order[]         @relation("SellerOrders")
  reviews            Review[]
  transactions       Transaction[]
  sentMessages       Message[]       @relation("SentMessages")
  receivedMessages   Message[]       @relation("ReceivedMessages")
  notifications      Notification[]
  passwordResets     PasswordResetToken[]
  sellerVerification SellerVerification? @relation("SellerVerificationRequest")

  @@index([email])
  @@index([username])
  @@index([isVerifiedSeller])
  @@index([isBanned])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([slug])
}

model Product {
  id              String   @id @default(cuid())
  title           String
  description     String
  shortDescription String?
  price           Float
  discountPrice   Float?
  fileUrl         String
  fileName        String
  fileSize        Int
  thumbnailUrl    String?
  demoUrl         String?
  tags            String?
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  downloadCount   Int      @default(0)
  viewCount       Int      @default(0)

  // Digital Product Features
  currentVersion  String   @default("1.0.0")
  downloadLimit   Int?     // null = unlimited downloads
  requiresLicense Boolean  @default(false)
  drmEnabled      Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sellerId        String
  seller          User     @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Cascade)

  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])

  orders          Order[]
  reviews         Review[]
  versions        ProductVersion[]
  licenseKeys     LicenseKey[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([createdAt])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  status          OrderStatus @default(PENDING)
  totalAmount     Float
  platformFee     Float
  sellerAmount    Float
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  completedAt     DateTime?

  buyerId         String
  buyer           User        @relation("BuyerOrders", fields: [buyerId], references: [id])

  sellerId        String
  seller          User        @relation("SellerOrders", fields: [sellerId], references: [id])

  productId       String
  product         Product     @relation(fields: [productId], references: [id])

  transactions    Transaction[]
  refunds         Refund[]
  licenseKeys     LicenseKey[]
  downloads       Download[]
  disputes        Dispute[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

model Transaction {
  id                String            @id @default(cuid())
  amount            Float
  currency          String            @default("USD")
  cryptoCurrency    String
  cryptoAmount      Float
  walletAddress     String
  transactionHash   String?
  status            TransactionStatus @default(PENDING)
  paymentGateway    String            @default("paygate")
  gatewayResponse   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  confirmedAt       DateTime?

  userId            String
  user              User              @relation(fields: [userId], references: [id])

  orderId           String
  order             Order             @relation(fields: [orderId], references: [id])

  paymentAttempts   PaymentAttempt[]

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([transactionHash])
}

enum PaymentAttemptStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  TIMEOUT
}

model PaymentAttempt {
  id              String              @id @default(cuid())
  transactionId   String
  transaction     Transaction         @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  attemptNumber   Int
  status          PaymentAttemptStatus @default(PENDING)
  errorCode       String?
  errorMessage    String?
  gatewayResponse String?             // JSON

  retryAfter      DateTime?           // When to retry next
  retryDelay      Int?                // Delay in seconds

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  completedAt     DateTime?

  @@index([transactionId])
  @@index([status])
  @@index([retryAfter])
  @@index([attemptNumber])
}

model Review {
  id              String   @id @default(cuid())
  rating          Int
  comment         String?
  isVerified      Boolean  @default(false)
  sellerResponse  String?
  respondedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  votes       ReviewVote[]

  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
}

model ReviewVote {
  id          String   @id @default(cuid())
  isHelpful   Boolean
  createdAt   DateTime @default(now())

  userId      String
  reviewId    String
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@index([reviewId])
}

model Message {
  id          String   @id @default(cuid())
  subject     String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId  String
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  productId   String?

  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  ORDER
  MESSAGE
  REVIEW
  PRODUCT
  SYSTEM
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  title       String
  message     String
  isRead      Boolean          @default(false)
  link        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id              String      @id @default(cuid())
  code            String      @unique
  type            CouponType
  value           Float
  minPurchase     Float?
  maxDiscount     Float?
  usageLimit      Int?
  usageCount      Int         @default(0)
  isActive        Boolean     @default(true)
  expiresAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  sellerId        String
  productId       String?

  @@index([code])
  @@index([sellerId])
  @@index([isActive])
  @@index([expiresAt])
}

model Bundle {
  id              String      @id @default(cuid())
  name            String
  description     String
  price           Float
  discountPercent Float
  isActive        Boolean     @default(true)
  salesCount      Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  sellerId        String
  productIds      String      // JSON array of product IDs

  @@index([sellerId])
  @@index([isActive])
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum LicenseStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model Refund {
  id              String        @id @default(cuid())
  reason          String
  status          RefundStatus  @default(PENDING)
  sellerResponse  String?
  refundAmount    Float
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  processedAt     DateTime?

  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId         String
  sellerId        String

  @@index([orderId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model ProductVersion {
  id              String   @id @default(cuid())
  version         String
  fileUrl         String
  fileName        String
  fileSize        Int
  changelog       String?
  isActive        Boolean  @default(true)
  downloadCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, version])
  @@index([productId])
  @@index([isActive])
  @@index([createdAt])
}

model LicenseKey {
  id              String        @id @default(cuid())
  key             String        @unique
  status          LicenseStatus @default(ACTIVE)
  maxActivations  Int           @default(1)
  activationCount Int           @default(0)
  expiresAt       DateTime?
  activatedAt     DateTime?
  revokedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  buyerId         String

  @@index([key])
  @@index([orderId])
  @@index([productId])
  @@index([buyerId])
  @@index([status])
}

model Download {
  id              String   @id @default(cuid())
  ipAddress       String?
  userAgent       String?
  downloadedAt    DateTime @default(now())

  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId       String
  versionId       String?

  buyerId         String

  @@index([orderId])
  @@index([productId])
  @@index([buyerId])
  @@index([downloadedAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model SellerVerification {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            User               @relation("SellerVerificationRequest", fields: [userId], references: [id], onDelete: Cascade)

  // Business Info
  businessName    String?
  businessType    String?
  taxId           String?

  // Identity Documents
  idDocumentUrl   String?
  proofOfAddress  String?

  // Status
  status          VerificationStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProductApproval {
  id              String         @id @default(cuid())
  productId       String         @unique
  status          ApprovalStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([productId])
  @@index([status])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id          String         @id @default(cuid())
  ticketNumber String        @unique
  userId      String
  orderId     String?

  subject     String
  description String
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)

  assignedTo  String?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages    TicketMessage[]

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([ticketNumber])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId     String
  message    String
  isStaff    Boolean  @default(false)

  createdAt  DateTime @default(now())

  @@index([ticketId])
}

model Referral {
  id              String   @id @default(cuid())
  code            String   @unique
  referrerId      String

  // Stats
  clicks          Int      @default(0)
  conversions     Int      @default(0)
  totalEarnings   Float    @default(0)

  // Config
  commissionRate  Float    @default(0.1) // 10% default
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  referrals       ReferralConversion[]

  @@index([code])
  @@index([referrerId])
}

model ReferralConversion {
  id          String   @id @default(cuid())
  referralId  String
  referral    Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  newUserId   String
  orderId     String?

  commission  Float
  paid        Boolean  @default(false)
  paidAt      DateTime?

  createdAt   DateTime @default(now())

  @@index([referralId])
  @@index([newUserId])
  @@index([orderId])
}

enum WebhookEvent {
  ORDER_CREATED
  ORDER_COMPLETED
  ORDER_REFUNDED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  REVIEW_CREATED
}

model Webhook {
  id          String   @id @default(cuid())
  userId      String

  url         String
  secret      String
  events      String   // JSON array of WebhookEvent
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs        WebhookLog[]

  @@index([userId])
  @@index([isActive])
}

model WebhookLog {
  id          String   @id @default(cuid())
  webhookId   String
  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  event       String
  payload     String   // JSON
  response    String?
  statusCode  Int?
  success     Boolean

  createdAt   DateTime @default(now())

  @@index([webhookId])
  @@index([createdAt])
}

enum ReportType {
  USER
  PRODUCT
  REVIEW
  MESSAGE
}

enum ReportReason {
  SPAM
  INAPPROPRIATE_CONTENT
  FRAUD
  COPYRIGHT_VIOLATION
  HARASSMENT
  FAKE_PRODUCT
  MALWARE
  OTHER
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

model ContentReport {
  id          String       @id @default(cuid())
  reporterId  String       // User who reported
  type        ReportType
  reason      ReportReason
  description String?
  status      ReportStatus @default(PENDING)

  // Polymorphic relations (only one should be set)
  targetUserId    String?
  targetProductId String?
  targetReviewId  String?
  targetMessageId String?

  // Admin handling
  assignedTo  String?
  resolution  String?
  resolvedAt  DateTime?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([reporterId])
  @@index([status])
  @@index([type])
  @@index([targetUserId])
  @@index([targetProductId])
  @@index([createdAt])
}

enum FraudRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudAlertType {
  MULTIPLE_FAILED_PAYMENTS
  SUSPICIOUS_REFUND_PATTERN
  RAPID_ACCOUNT_CREATION
  UNUSUAL_PURCHASE_PATTERN
  HIGH_CHARGEBACK_RATE
  FAKE_REVIEWS
  PRICE_MANIPULATION
  DUPLICATE_ACCOUNT
}

model FraudAlert {
  id          String         @id @default(cuid())
  userId      String
  alertType   FraudAlertType
  riskLevel   FraudRiskLevel
  description String
  metadata    String?        // JSON with additional details

  isResolved  Boolean        @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?        // Admin user ID
  resolution  String?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
  @@index([riskLevel])
  @@index([isResolved])
  @@index([createdAt])
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  AWAITING_RESPONSE
  RESOLVED
  ESCALATED
  CLOSED
}

enum DisputeReason {
  PRODUCT_NOT_AS_DESCRIBED
  FILE_CORRUPTED
  WRONG_PRODUCT
  NOT_RECEIVED
  SELLER_NOT_RESPONDING
  REFUND_NOT_PROCESSED
  LICENSE_ISSUE
  OTHER
}

enum DisputeOutcome {
  BUYER_FAVOR
  SELLER_FAVOR
  PARTIAL_REFUND
  FULL_REFUND
  NO_REFUND
  REPLACE_PRODUCT
}

model Dispute {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  buyerId     String
  sellerId    String

  reason      DisputeReason
  description String
  status      DisputeStatus  @default(OPEN)
  outcome     DisputeOutcome?

  // Admin assignment
  assignedTo  String?        // Admin user ID
  assignedAt  DateTime?

  // Resolution
  resolution  String?
  resolvedAt  DateTime?
  resolvedBy  String?        // Admin user ID

  // Evidence
  buyerEvidence  String?     // JSON array of evidence URLs/text
  sellerEvidence String?     // JSON array of evidence URLs/text

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages    DisputeMessage[]

  @@index([orderId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([assignedTo])
  @@index([createdAt])
}

model DisputeMessage {
  id          String   @id @default(cuid())
  disputeId   String
  dispute     Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  senderId    String
  message     String
  isInternal  Boolean  @default(false) // Admin-only notes
  attachments String?  // JSON array of attachment URLs

  createdAt   DateTime @default(now())

  @@index([disputeId])
  @@index([senderId])
  @@index([createdAt])
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model IdempotencyKey {
  id          String            @id @default(cuid())
  key         String            @unique
  userId      String
  endpoint    String
  requestBody String?           // JSON of the request body

  status      IdempotencyStatus @default(PROCESSING)
  response    String?           // JSON of the response
  statusCode  Int?

  createdAt   DateTime          @default(now())
  expiresAt   DateTime

  @@index([key])
  @@index([userId])
  @@index([expiresAt])
}

// ==============================================
// SOCIAL FEATURES
// ==============================================

model Follow {
  id          String   @id @default(cuid())
  followerId  String   // User who is following
  followingId String   // User being followed (usually a seller)

  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([createdAt])
}

model ProductLike {
  id        String   @id @default(cuid())
  userId    String
  productId String

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([createdAt])
}

model ProductShare {
  id        String   @id @default(cuid())
  userId    String
  productId String
  platform  String   // 'twitter', 'facebook', 'linkedin', 'email', 'copy'

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([productId])
  @@index([platform])
  @@index([createdAt])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([createdAt])
}

model Collection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  productIds  String   // JSON array of product IDs

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([isPublic])
  @@index([createdAt])
}

// ==============================================
// MARKETING TOOLS
// ==============================================

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
}

enum CampaignType {
  PROMOTIONAL
  NEWSLETTER
  ANNOUNCEMENT
  TRANSACTIONAL
}

model EmailCampaign {
  id           String         @id @default(cuid())
  name         String
  subject      String
  htmlContent  String
  textContent  String?
  type         CampaignType   @default(PROMOTIONAL)
  status       CampaignStatus @default(DRAFT)

  // Targeting
  targetRole   String?        // 'BUYER', 'SELLER', 'ALL'
  targetTier   String?        // Subscription tier filter
  recipientIds String?        // JSON array of specific user IDs

  // Scheduling
  scheduledFor DateTime?
  sentAt       DateTime?

  // Stats
  totalRecipients Int @default(0)
  sent            Int @default(0)
  delivered       Int @default(0)
  opened          Int @default(0)
  clicked         Int @default(0)
  bounced         Int @default(0)
  unsubscribed    Int @default(0)

  createdBy    String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([type])
  @@index([scheduledFor])
  @@index([createdBy])
  @@index([createdAt])
}

enum PromotionType {
  PERCENTAGE_OFF
  FIXED_AMOUNT_OFF
  BUY_ONE_GET_ONE
  FREE_SHIPPING
  BUNDLE_DEAL
}

model Promotion {
  id          String        @id @default(cuid())
  name        String
  description String
  type        PromotionType

  // Discount details
  discountPercentage Float?
  discountAmount     Float?
  minimumPurchase    Float?

  // Product targeting
  productIds   String?      // JSON array - null = all products
  categoryIds  String?      // JSON array - null = all categories
  sellerIds    String?      // JSON array - null = all sellers

  // Usage limits
  maxUsesPerUser    Int?
  maxTotalUses      Int?
  currentUses       Int       @default(0)

  // Active period
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean      @default(true)

  createdBy    String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([isActive])
  @@index([startDate])
  @@index([endDate])
  @@index([createdBy])
  @@index([type])
}

model PromotionUsage {
  id          String   @id @default(cuid())
  promotionId String
  userId      String
  orderId     String?

  discount    Float
  usedAt      DateTime @default(now())

  @@index([promotionId])
  @@index([userId])
  @@index([orderId])
  @@index([usedAt])
}

model NewsletterSubscription {
  id          String   @id @default(cuid())
  email       String   @unique
  userId      String?  // null if not registered user
  isActive    Boolean  @default(true)

  subscribedAt   DateTime @default(now())
  unsubscribedAt DateTime?

  @@index([email])
  @@index([userId])
  @@index([isActive])
}

// ==============================================
// ESCROW SYSTEM
// ==============================================

enum EscrowStatus {
  CREATED
  FUNDED
  GOODS_DELIVERED
  COMPLETED
  DISPUTED
  REFUNDED
  CANCELLED
}

model EscrowTransaction {
  id            String       @id @default(cuid())
  orderId       String       @unique

  buyerId       String
  sellerId      String
  amount        Float
  platformFee   Float

  status        EscrowStatus @default(CREATED)

  // Blockchain details (for crypto escrow)
  escrowAddress String?      // Smart contract or multi-sig wallet address
  txHash        String?      // Transaction hash for funding
  releaseHash   String?      // Transaction hash for release

  // Timeframes
  fundedAt      DateTime?
  deliveredAt   DateTime?
  releasedAt    DateTime?
  expiresAt     DateTime?

  // Dispute
  disputeId     String?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([orderId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
}

// ==============================================
// PAYMENT SETTINGS (Admin Configurable)
// ==============================================

enum PaymentProvider {
  MOONPAY
  BANXA
  TRANSAK
  STRIPE
  MULTI_PROVIDER // Shows all providers to user
}

model PaymentSettings {
  id        String   @id @default(cuid())

  // PayGate.to Configuration
  paygateEnabled        Boolean @default(true)
  paygateMerchantWallet String? // Polygon USDC wallet address
  paygateBaseUrl        String  @default("https://api.paygate.to")
  paygateCheckoutUrl    String  @default("https://checkout.paygate.to")

  // Payment Provider Settings
  defaultProvider       PaymentProvider @default(MULTI_PROVIDER)
  enabledProviders      String @default("moonpay,banxa,transak,stripe") // Comma-separated

  // Payment Methods
  enableCreditCard      Boolean @default(true)
  enableApplePay        Boolean @default(true)
  enableGooglePay       Boolean @default(true)
  enableBankTransfer    Boolean @default(true)

  // Currency Settings
  supportedCurrencies   String @default("USD,EUR,GBP,CAD") // Comma-separated
  defaultCurrency       String @default("USD")

  // Fee Configuration
  platformFeePercentage Float   @default(5.0)   // Platform fee %
  paygateFeePercentage  Float   @default(1.0)   // PayGate.to fee %
  minimumOrderAmount    Float   @default(5.0)   // Minimum order in USD
  maximumOrderAmount    Float   @default(10000.0) // Maximum order in USD

  // Escrow Settings
  escrowEnabled         Boolean @default(true)
  escrowThreshold       Float   @default(100.0) // Orders >= this amount use escrow
  escrowAutoReleaseHours Int    @default(72)    // Auto-release after N hours

  // Advanced Settings
  testMode              Boolean @default(false)  // Use testnet/sandbox
  customDomain          String? // White-label domain for PayGate
  callbackUrl           String? // Override callback URL

  // Affiliate Settings
  affiliateEnabled      Boolean @default(false)
  affiliateWallet       String? // Affiliate Polygon wallet
  affiliateFeePercentage Float  @default(10.0)  // Affiliate commission %

  // Metadata
  updatedBy     String?  // Admin user ID who last updated
  notes         String?  // Admin notes

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("payment_settings")
}
