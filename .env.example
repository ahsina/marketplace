# ==============================================
# CRYPTOMARKET - ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env and fill in your values
# ==============================================

# ----------------------------------------------
# DATABASE
# ----------------------------------------------
# SQLite (Development - Default)
DATABASE_URL="file:./dev.db"

# PostgreSQL (Production - Recommended)
# DATABASE_URL="postgresql://user:password@localhost:5432/cryptomarket?schema=public"

# Neon PostgreSQL (Serverless)
# DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb"

# Supabase PostgreSQL
# DATABASE_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"

# ----------------------------------------------
# AUTHENTICATION
# ----------------------------------------------
# JWT Secret - Generate with: openssl rand -base64 32
# IMPORTANT: Use a strong, unique secret in production
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters-long"

# JWT Expiration
JWT_EXPIRES_IN="7d"

# ----------------------------------------------
# APPLICATION
# ----------------------------------------------
# App URL (change in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# App Name
NEXT_PUBLIC_APP_NAME="CryptoMarket"

# Node Environment
NODE_ENV="development"

# Platform Fees (percentage)
PLATFORM_FEE_PERCENTAGE=5

# ----------------------------------------------
# FILE UPLOAD - CLOUDINARY
# ----------------------------------------------
# Get free account: https://cloudinary.com/users/register/free
# Free tier: 25 GB storage, 25 GB bandwidth/month
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ----------------------------------------------
# EMAIL - RESEND
# ----------------------------------------------
# Get free account: https://resend.com/signup
# Free tier: 100 emails/day, 3,000/month
RESEND_API_KEY="re_your_api_key_here"
FROM_EMAIL="noreply@yourdomain.com"

# ----------------------------------------------
# BACKGROUND JOBS - REDIS
# ----------------------------------------------
# Local Redis (Development)
REDIS_URL="redis://localhost:6379"

# Redis Cloud (Production)
# REDIS_URL="redis://default:password@redis-12345.cloud.redislabs.com:12345"

# Upstash Redis (Serverless - Recommended for serverless deployments)
# REDIS_URL="rediss://default:password@region.upstash.io:6379"

# ----------------------------------------------
# CRYPTO PAYMENTS - PAYGATE.TO
# ----------------------------------------------
# Fiat-to-crypto payment gateway
# Customers pay with cards/bank transfers, merchant receives USDC on Polygon
# Documentation: https://documenter.getpostman.com/view/14826208/2sA3Bj9aBi

# Merchant Polygon Wallet Address (REQUIRED)
# Create a Polygon wallet (MetaMask, Trust Wallet, etc.)
# Ensure it supports USDC on Polygon network (not Ethereum mainnet!)
PAYGATE_MERCHANT_WALLET="0xYourPolygonWalletAddress"
PLATFORM_WALLET_ADDRESS="0xYourPolygonWalletAddress"  # Fallback

# Optional: Override default API endpoints
# PAYGATE_BASE_URL="https://api.paygate.to"
# PAYGATE_CHECKOUT_URL="https://checkout.paygate.to"

# Important Notes:
# - No API keys required (wallet-based authentication)
# - Customers pay with cards/Apple Pay/Google Pay/Bank transfers
# - Merchant receives USDC on Polygon (1% fee by PayGate.to)
# - Payouts usually arrive within 5-15 minutes
# - Use dedicated merchant wallet (separate from personal funds)

# ----------------------------------------------
# ADMIN ACCOUNT (Initial Setup)
# ----------------------------------------------
# Default admin credentials (change after first login)
ADMIN_EMAIL="admin@cryptomarket.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-secure-password"

# ----------------------------------------------
# OPTIONAL - ANALYTICS & MONITORING
# ----------------------------------------------
# Google Analytics (Optional)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Sentry Error Tracking (Optional)
# SENTRY_DSN="https://xxxxx@sentry.io/xxxxx"
# SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# PostHog Analytics (Optional)
# NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxx"
# NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ----------------------------------------------
# OPTIONAL - RATE LIMITING (Future Enhancement)
# ----------------------------------------------
# Upstash Rate Limiting (Optional)
# UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxxx"

# ----------------------------------------------
# OPTIONAL - SEARCH (Future Enhancement)
# ----------------------------------------------
# Algolia Search (Optional)
# NEXT_PUBLIC_ALGOLIA_APP_ID="your-app-id"
# NEXT_PUBLIC_ALGOLIA_SEARCH_KEY="your-search-key"
# ALGOLIA_ADMIN_KEY="your-admin-key"

# Meilisearch (Self-hosted alternative)
# MEILISEARCH_HOST="http://localhost:7700"
# MEILISEARCH_MASTER_KEY="your-master-key"

# ----------------------------------------------
# NOTES & BEST PRACTICES
# ----------------------------------------------
# 1. NEVER commit .env file to git (.env is in .gitignore)
# 2. Use different values for dev/staging/production
# 3. Rotate secrets regularly in production
# 4. Use managed services in production:
#    - Database: Neon, Supabase, Railway, PlanetScale
#    - Redis: Upstash (serverless), Redis Cloud
#    - File Storage: Cloudinary
# 5. Enable HTTPS in production (required for crypto payments)
# 6. Set strong JWT_SECRET (32+ characters, random)
# 7. Keep RESEND_API_KEY and PAYGATE secrets secure
# 8. Use environment variables in hosting platform:
#    - Vercel: Settings → Environment Variables
#    - Railway: Variables tab
#    - Heroku: Config Vars

# ----------------------------------------------
# PRODUCTION DEPLOYMENT CHECKLIST
# ----------------------------------------------
# ✅ Change JWT_SECRET to strong random value
# ✅ Update DATABASE_URL to production PostgreSQL
# ✅ Add Cloudinary credentials
# ✅ Add Resend API key
# ✅ Set up Redis (Upstash recommended)
# ✅ Add PayGate.to merchant wallet (Polygon USDC address)
# ✅ Verify wallet supports USDC on Polygon network
# ✅ Test small payment transaction before going live
# ✅ Change admin password after first login
# ✅ Set NEXT_PUBLIC_APP_URL to production domain
# ✅ Enable HTTPS (required for PayGate webhooks)
# ✅ Set NODE_ENV="production"
# ✅ Test email delivery (verification, order confirmations)
# ✅ Test file uploads (product images, downloads)
# ✅ Test crypto payments (small test transaction on each supported currency)
# ✅ Verify PayGate webhooks are being received and processed
# ✅ Confirm escrow creation for high-value orders (>= $100)
# ✅ Test payment confirmations and order completion flow
